{
  "name": "webframe",
  "version": "0.1.0",
  "description": "Typed middleware for Node's HTTP server, and the helpers that go with it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/node/*",
    "packages/universal/*",
    "packages/react/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "test": "tsc --build && node --test \"test/*.test.js\"",
    "docs": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "middleware-types": "node scripts/middleware-types.mjs",
    "readmes": "node scripts/readmes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=22"
  }
}
